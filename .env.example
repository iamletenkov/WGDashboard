# Access mode (README, section 2): domain | ip | empty (panel only on 127.0.0.1).
COMPOSE_PROFILES=domain
# domain: the panel's DNS name; ip: the server's address (gets a self-signed certificate).
DOMAIN=example.org
CERTBOT_EMAIL=your@email.com
# ip: lifetime of the self-signed certificate in days (domain: a 1-day placeholder).
SELF_SIGNED_DAYS=1
# nginx directives for the panel, e.g. "allow 10.0.0.0/8; allow 192.168.0.0/16; deny all;"
PANEL_ACCESS=allow all;


TZ=Europe/Moscow
WGD_PORT=5000
USERNAME=admin
PASSWORD=change-me
GLOBAL_DNS=8.8.8.8

# Public address (or DNS name) of this server for peer configs.
PUBLIC_IP=
# Interfaces to bring up on container start, separated by || (e.g. awg0||awg1).
WG_AUTOSTART=awg0

# Image versions: WGDashboard release and amneziawg-tools tag matching the host kernel module.
WGD_VERSION=v4.3.3
AWG_TOOLS_REF=v3.1.20260812
