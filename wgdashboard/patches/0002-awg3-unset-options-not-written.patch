+# AmneziaWG 3.x interface options. A config written by an older AmneziaWG or by
+# WGDashboard without these options keeps them unset; "0" and "" mean unset and the
+# key is never written, because awg rejects e.g. "HeaderProtectionKey = 0" and a
+# client without AWG 3.x support rejects any of these keys.
+AWG3_KEYS = ["HeaderProtectionKey", "ContentPaddingAddition", "RekeyAfterTime", "RekeyTimeout",
+             "RejectAfterTime", "KeepaliveTimeout", "MaxHandshakeAttempts", "RandomTrailers", "DisableCookies"]
+
+
+def IsUnsetAwg3Value(key: str, value) -> bool:
+    return key in AWG3_KEYS and (value is None or str(value).strip() in ("", "0"))
+
+
 def StringToBoolean(value: str):
     """
     Convert string boolean to boolean
